# App
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ADMIN_BASE_PATH=/admin

# Supabase (project: architak-media — RLS on by default)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Admin auth (server-only — never NEXT_PUBLIC_*)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cloudflare R2 (bucket: architak-media — private ACL; keys use public/ and private/)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=architak-media
R2_ENDPOINT=
# Testing (no custom domain yet): workers.dev. Production cutover: https://media.architak.in
R2_PUBLIC_BASE_URL=https://architak-media.architak.workers.dev

# Operator bootstrap (local only — never commit; not required by the Next.js app)
# DATABASE_URL=postgresql://postgres:...@db.<project-ref>.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=
# CLOUDFLARE_API_TOKEN=

# Contact (public-safe, still env-driven)
CONTACT_PHONE=+918891991999
CONTACT_EMAIL=architak336@gmail.com
CONTACT_WHATSAPP=+918891991999

# Discovery / AI crawlers (comma-separated user-agent tokens)
DISCOVERY_AI_CRAWLERS_ALLOW=Googlebot,Google-Extended,Bingbot,GPTBot,ChatGPT-User,OAI-SearchBot,ClaudeBot,PerplexityBot,Applebot
DISCOVERY_AI_CRAWLERS_DENY=
DISCOVERY_LLMS_FULL_ENABLED=false
DISCOVERY_PUBLIC_API_ENABLED=true

# Security
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Feature flags
FEATURE_JOURNAL_NAV=false
FEATURE_THREE_D=false
