# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets; keep the example
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Large featured-work uploads (served from R2; run pnpm media:upload-featured locally)
/public/media/featured-works/*.mp4
/public/media/featured-works/*.mov
/public/media/featured-works/*.MP4
/public/media/featured-works/*.MOV
# Keep next-env.d.ts tracked for IDE support
