{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "crons": [
    {
      "path": "/api/cron/supabase-keepalive",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/traffic-retention",
      "schedule": "15 3 * * *"
    }
  ]
}
